# Copy this to ".env" beside docker-compose.yml. Every setting has a working
# default, so an empty .env — or none at all — is fine to start with.
#
#   cp env.example .env

# --- where it listens --------------------------------------------------------

# The host address the port is published on. 127.0.0.1 means only this machine
# can reach it, which is the default on purpose: ENCLAVE has no login of its
# own. Change it to 0.0.0.0 only once something in front of it authenticates.
ENCLAVE_BIND=127.0.0.1
ENCLAVE_PORT=8080

# --- how it behaves ----------------------------------------------------------

# "on" serves the interface but refuses every change. Use it for an instance
# an auditor or a programme office reads, and keep a separate writable one for
# the people doing the work.
ENCLAVE_READ_ONLY=off

# The zone timestamps are written in. UTC unless a report has to read local.
TZ=UTC

# Stamped into the binary at build time and shown in the footer, so a
# screenshot in a report says which build produced it. A git SHA or a release
# tag is the useful thing to put here.
ENCLAVE_VERSION=docker

# --- the tls profile ---------------------------------------------------------
# Only read when you start with: docker compose --profile tls up -d

# The name people type, which has to match the certificate.
ENCLAVE_HOSTNAME=localhost
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Passwords are NOT set here. They live in deploy/auth/users.conf, because a
# bcrypt hash is full of dollar signs that a compose file would try to expand,
# and because an environment variable shows up in "docker inspect".

# --- connector credentials ---------------------------------------------------
# Not here either. Put API keys in enclave.env if you want them outside the
# data volume; see docs/deploying.md. The simpler route is to type them into
# the connector page, which stores them in the volume at mode 0600.
