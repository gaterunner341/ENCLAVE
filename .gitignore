# Local build output. The Windows build published for download is committed
# deliberately as ENCLAVE.exe in the repository root, so it is not listed here.
/enclave
/enclave.exe
/dist/

# runtime data directory (never commit an operational data set)
/enclave-data/
*.enclavedb

# editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# deployment: local settings and anything that authenticates
.env
enclave.env
/deploy/auth/users.conf
/deploy/certs/*
!/deploy/certs/README.md
