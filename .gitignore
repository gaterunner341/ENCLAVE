# Build output. ENCLAVE ships as a container image, so no binary belongs in
# the repository.
/enclave
/enclave.exe
/ENCLAVE.exe
/dist/

# runtime data directory (never commit an operational data set)
/enclave-data/
*.enclavedb

# editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# deployment: local settings and anything that authenticates
.env
enclave.env
/deploy/auth/users.conf
/deploy/certs/*
!/deploy/certs/README.md
